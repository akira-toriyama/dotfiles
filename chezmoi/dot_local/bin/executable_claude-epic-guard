#!/usr/bin/env bash
# claude-epic-guard — PreToolUse guard for the two epic decisions that are the
# human's: switching the active epic and closing an epic.
#
# ASKS before a Bash call runs `furrow epic activate`, `furrow epic deactivate`
# or `furrow epic done` against a board this machine is configured to use. The
# rule it carries (user decision 2026-11-16, projects t-9cby): Claude may APPLY
# for either operation, and it runs only on the human's instruction naming that
# operation — a bare "GO" is not one. The dialog shows the exact command, so the
# human's approval of it IS that instruction; the rule therefore lives here and
# not as prose in a CLAUDE.md. Before this guard the activate half was written
# in five places that disagreed with each other, and the close half nowhere.
# When Claude may apply is a judgment and stays prose: the epic-ops skill.
#
# A subagent gets a DENY, not an ask. A non-interactive subagent has nobody to
# answer a dialog and stops for good — measured on the first version of
# claude-board-shard-guard (2026-08-19). The deny reason sends the request back
# to the parent session, which is the one that can apply to the human.
#
# Measured on Claude Code 2.1.318 (2026-11-16, the guard passed with
# --settings): under auto mode all three commands raised the dialog, with Yes /
# No as the only choices; a decline ran nothing and ended the turn; and a
# headless `claude -p` refused a command that --allowedTools had pre-allowed,
# where the same run without the guard executed it.
#
# This is a tripwire against a misread instruction, not a security boundary:
# it favours never asking about text over catching every spelling.
#
# What counts as running one of the three commands. A lexer first reduces the
# command to its command positions, one codepoint for one, so a span found in
# the reduced text is cut from the raw text for the dialog. Masked as data:
# quoted text ('…', "…", $'…'), ${…} expansions, `#` comments and heredoc
# bodies. Kept as command text: `$( … )` and backtick spans, also inside double
# quotes, and the body of a heredoc fed to a shell (`bash <<EOF`). Two earlier
# versions show why it is one pass: matching the raw text asked about `git
# commit -m '… furrow epic done …'` and about 15 commands of this machine's
# transcripts that only mention one; masking heredocs and quotes in two
# separate passes then MISSED real calls, because a `<<EOF` inside a quote or a
# comment hid the code after it.
# On the reduced text, a command is `furrow epic <verb>` at the start of a line
# or after one of | ; & ` ( ) {, behind any run of words. Those words are what
# a session really puts there: VAR=value assignments, a shell keyword (then,
# do, if), command / exec / time / xargs / timeout 30, `go run` — `go run
# ./cmd/furrow epic done` from furrow's own checkout writes the same board —
# and a wrapper function of its own (`step furrow epic done e-1` closed a box
# on 2026-11-05). echo and printf are not wrappers, and neither is furrow
# itself (`furrow note <id> furrow epic …`). An occurrence carrying --help /
# -h is a read and passes.
#
# Replayed over the distinct Bash commands that name furrow and epic in this
# machine's transcripts (2026-11-16, a stub furrow reporting the configured
# board for every call): 70 of 1794 flagged, each a real call of the three
# commands. The first version, matching the raw text, flagged 80 of 1790.
#
# ONLY the configured boards are in scope, and the board is not guessed from the
# path: the guard asks furrow itself (`furrow board --json`, a read) from the
# directory the command will run in — the hook's cwd, or the command's own
# leading `cd /abs` — and compares the store it reports with the [[board]]
# paths of furrow's user config. A FURROW_DIR or FURROW_BOARD the command
# assigns in front of that very furrow call is handed to the read; one that
# sits on another command of the line, or inside a quote, is not this call's.
# Scratch boards, fixtures and other people's checkouts report another store,
# or none, and pass. That is what keeps furrow's own development and the drills
# on throwaway boards out of the dialog.
#
# Blind spots — each makes the guard MISS a real call:
#   - a command reaching furrow through a script file, an alias, a variable,
#     `eval` or `bash -c '…'`, or a spelling that quotes or escapes one of the
#     words furrow / epic / the verb. `projects repo retire` closes boxes
#     through a script, by design of that command.
#   - a `cd` later than the leading one, or a leading one whose path needs
#     quoting for spaces, is not followed: the board is resolved from the
#     hook's cwd. `export FURROW_DIR=…` on an earlier line is not followed
#     either, and a FURROW_DIR given as a shell variable is handed over
#     unexpanded, so furrow resolves nothing and the call passes.
#   - a call that assigns XDG_CONFIG_HOME in front of itself is a rig with its
#     own furrow config, which this process cannot reproduce: it passes.
#   - shell the lexer does not model: `case` patterns inside `$( )`, a heredoc
#     inside `(( ))`, process substitution feeding a shell.
# And one that makes it ask about a harmless call: a command whose own
# arguments spell one (`grep furrow epic done file`).
# When the lexer ends inside an open quote, substitution or heredoc it has lost
# track, and so has a command longer than 200000 codepoints, which is not
# lexed: both fall back to matching the raw text at a strict command position,
# which errs toward asking.
#
# Fail-open by construction: no jq, unparseable stdin, another tool, no furrow
# on PATH, a furrow that errors or reports no store, or no readable furrow
# config → allow. FURROW_CONFIG overrides the config path for the tests, as it
# does for claude-board-shard-guard; furrow itself does not read it.
#
# Owned by dotfiles (chezmoi → ~/.local/bin/claude-epic-guard); wired from the
# Claude PreToolUse hook in modify_settings.json (step 12).
# Tests: scripts/test_claude_epic_guard.py (unittest, CI).
set -u

command -v jq >/dev/null 2>&1 || exit 0

input=$(cat 2>/dev/null) || exit 0
[ -n "$input" ] || exit 0
printf '%s' "$input" | jq -e . >/dev/null 2>&1 || exit 0

tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null)
[ "$tool" = "Bash" ] || exit 0

cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty | strings' 2>/dev/null)

# Two substrings first (cheap), so an ordinary Bash call never pays for the lexer.
case $cmd in
*furrow*epic*) ;;
*) exit 0 ;;
esac

# The lexer. Codepoints, since the program sits in single quotes: 9 tab, 10
# newline, 32 space, 34 ", 35 #, 36 $, 38 &, 39 the single quote, 40 ( 41 ),
# 45 -, 47 /, 59 ;, 60 < 62 >, 92 backslash, 95 the mask (_), 96 backtick,
# 123 { 125 }, 124 |.
# Frames on .st — command text: N top level, P a $( ) opened inside data,
# B backticks. Data: S '…', A $'…', D "…", V ${…} (q: opened inside double
# quotes, where a single quote is literal), C a comment, H a heredoc body.
# It is a foreach, not a reduce: the state stays small and every step emits
# one codepoint, so the run is linear (a reduce that grew the output inside
# its state took 21 s for 100000 characters).
# shellcheck disable=SC2016  # a jq program: its $names are jq's, not the shell's
lexer='
def frame: .st[(.st | length) - 1];
def pop: .st |= .[:-1];
def push($f): .st += [$f];
def emit($o): .o = $o;

def end_word:
  (.word | implode) as $w
  | (if $w == "bash" or $w == "sh" or $w == "zsh" or $w == "dash" or $w == "ksh"
     then .shell = true else . end)
  | .word = [];

def open_heredoc: push({t: "H", pos: 0, ok: true, lead: true} + .pend[0]) | .pend |= .[1:];

# A newline in command text starts the bodies announced on that line. Bodies
# fed to a shell are code: they are left to be read as command text.
def newline:
  (if (.pend | length) == 0 then .
   elif any(.pend[]; .code) then .pend = []
   else open_heredoc end)
  | emit(10);

def h_step($c):
  frame as $f
  | ((.st | length) - 1) as $i
  | if $c == 10 then
      (if $f.ok and $f.pos == ($f.delim | length)
       then pop | (if (.pend | length) > 0 then open_heredoc else . end)
       else .st[$i].pos = 0 | .st[$i].ok = true | .st[$i].lead = true end)
      | emit(10)
    elif $f.lead and $f.strip and $c == 9 then emit(95)
    elif $f.ok and $f.pos < ($f.delim | length) and $f.delim[$f.pos] == $c
    then .st[$i].pos += 1 | .st[$i].lead = false | emit(95)
    else .st[$i].ok = false | .st[$i].lead = false | emit(95)
    end;

def d_step($c):
  if .esc then .esc = false | emit(95)
  elif $c == 92 then .esc = true | emit(95)
  elif $c == 34 then pop | emit(95)
  elif $c == 40 and .dol then push({t: "P", d: 0}) | emit(40)
  elif $c == 123 and .dol then push({t: "V", q: true}) | emit(95)
  elif $c == 96 then push({t: "B", d: 0}) | emit(96)
  else emit(95)
  end;

def v_step($c):
  frame.q as $q
  | if .esc then .esc = false | emit(95)
    elif $c == 92 then .esc = true | emit(95)
    elif $c == 125 then pop | emit(95)
    elif $c == 34 then push({t: "D"}) | emit(95)
    elif $c == 39 and ($q | not) then push({t: "S"}) | emit(95)
    elif $c == 40 and .dol then push({t: "P", d: 0}) | emit(40)
    elif $c == 123 and .dol then push({t: "V", q: $q}) | emit(95)
    elif $c == 96 then push({t: "B", d: 0}) | emit(96)
    else emit(95)
    end;

# The word after << : .hd collects the delimiter. .redo hands the character
# that ended it on to cmd_step. A delimiter that starts with a digit is a
# shift (1<<2), and <<< is a here-string.
def hd_step($c):
  .hd as $h
  | if $h.q != 0 then
      (if $c == $h.q then .hd.q = 0
       elif ($h.delim | length) > 80 then .hd = null
       else .hd.delim += [$c] end)
      | emit(95)
    elif $h.ph == 1 and $c == 60 then .hd = null | emit(60)
    elif $h.ph == 1 and $c == 45 then .hd.strip = true | .hd.ph = 2 | emit(45)
    elif $h.ph <= 2 and ($c == 32 or $c == 9) then .hd.ph = 2 | emit($c)
    elif $c == 39 or $c == 34 then .hd.q = $c | .hd.ph = 3 | emit(95)
    elif $c == 92 then .hd.ph = 3 | emit(95)
    elif $c == 32 or $c == 9 or $c == 10 or $c == 59 or $c == 38 or $c == 124
         or $c == 60 or $c == 62 or $c == 40 or $c == 41
    then
      (if ($h.delim | length) > 0 and (($h.delim[0] >= 48 and $h.delim[0] <= 57) | not)
       then .pend += [{delim: $h.delim, strip: $h.strip, code: .shell}]
       else . end)
      | .hd = null | .redo = true
    elif ($h.delim | length) > 80 then .hd = null | emit(95)
    else .hd.delim += [$c] | .hd.ph = 3 | emit(95)
    end;

def cmd_step($c):
  frame as $f
  | ((.st | length) - 1) as $i
  | if .esc then .esc = false | .word = [0] | emit(if $c == 10 then 32 else 95 end)
    elif $c == 92 then .esc = true | emit(32)
    elif $c == 39 then end_word | push({t: (if .dol then "A" else "S" end)}) | emit(95)
    elif $c == 34 then end_word | push({t: "D"}) | emit(95)
    elif $c == 96 then end_word | (if $f.t == "B" then pop else push({t: "B", d: 0}) end) | emit(96)
    elif $c == 123 and .dol then push({t: "V", q: false}) | emit(95)
    elif $c == 40 then end_word | .shell = false | .st[$i].d += 1 | emit(40)
    elif $c == 41 then
      end_word | .shell = false
      | (if $f.t == "P" and $f.d == 0 then pop else .st[$i].d = ([$f.d - 1, 0] | max) end)
      | emit(41)
    elif $c == 35 and .tok_start then push({t: "C"}) | emit(95)
    elif $c == 60 then
      end_word | .lt += 1
      | (if .lt == 2 then .hd = {ph: 1, strip: false, delim: [], q: 0} else . end)
      | emit(60)
    elif $c == 10 then end_word | .shell = false | newline
    elif $c == 59 or $c == 38 or $c == 124 then end_word | .shell = false | emit($c)
    elif $c == 32 or $c == 9 then end_word | emit($c)
    elif $c == 47 then .word = [] | emit($c)
    else (if (.word | length) < 8 then .word += [$c] else .word = [0] end) | emit($c)
    end;

def step($c):
  .redo = false
  | .esc as $escaped
  | frame.t as $t
  | (if $t == "H" then h_step($c)
     elif $t == "S" then (if $c == 39 then pop else . end) | emit(95)
     elif $t == "A" then
       (if .esc then .esc = false
        elif $c == 92 then .esc = true
        elif $c == 39 then pop
        else . end)
       | emit(95)
     elif $t == "C" then (if $c == 10 then pop | .shell = false | newline else emit(95) end)
     elif $t == "D" then d_step($c)
     elif $t == "V" then v_step($c)
     else
       (if .hd != null then hd_step($c) else .redo = true end)
       | (if .redo then cmd_step($c) else . end)
     end)
  | ($t == "N" or $t == "P" or $t == "B") as $code
  | .dol = ($c == 36 and ($escaped | not) and ($code or $t == "D" or $t == "V"))
  | .tok_start = ((($code and ($escaped | not))
                   and ($c == 32 or $c == 9 or $c == 10 or $c == 59 or $c == 38
                        or $c == 124 or $c == 40 or $c == 41 or $c == 96))
                  or (($t == "C" or $t == "H") and $c == 10))
  | (if $c != 60 or ($code | not) or $escaped then .lt = 0 else . end);

# Lost track = still inside a quote, an expansion, a substitution, or a
# heredoc whose delimiter never came. A comment may run to the end, and so
# may a heredoc whose last line is its delimiter.
def clean:
  (.st | length) as $n
  | frame as $f
  | $n == 1
    or ($n == 2 and $f.t == "C")
    or ($n == 2 and $f.t == "H" and $f.ok and $f.pos == ($f.delim | length));

def lex:
  [foreach (explode[], -1) as $c (
      {st: [{t: "N", d: 0}], esc: false, dol: false, tok_start: true, lt: 0,
       hd: null, pend: [], shell: false, word: [], redo: false, o: 0};
      if $c == -1 then .o = (if clean then -1 else -2 end) else step($c) end;
      .o)]
  | if .[length - 1] == -1 then .[:-1] | implode else null end;

def env_value($name):
  ([match("(?:^|[ \\t])" + $name + "=(?:\"([^\"]*)\"|\\x27([^\\x27]*)\\x27|(\\S*))")
    | [.captures[].string] | map(select(. != null)) | first] | first) // "";

# Group 1 is the run of words in front of furrow, group 2 the verb.
def calls($text; $raw; $words):
  [ $text
    | match("(?:^|[|;&`(){\\n])[ \\t]*(" + $words + ")(?:[^\\s|;&`(){}<>]*/)?furrow(?:[ \\t]+--?[A-Za-z][A-Za-z0-9-]*(?:=\\S*)?)*[ \\t]+epic[ \\t]+(activate|deactivate|done)(?=[\\s|;&)`}<>]|$)[^|;&)`\\n]*"; "g")
    | . as $m
    | $m.captures[0] as $w
    | $raw[$w.offset : $w.offset + $w.length] as $front
    | select($m.string | test("[ \\t](?:--help|-h)(?:[ \\t]|$)") | not)
    | { kind: (if $m.captures[1].string == "done" then "close" else "switch" end),
        op: ($raw[$m.offset : $m.offset + $m.length]
             | sub("^[|;&`(){\\n]?[ \\t]*"; "") | gsub("[ \\t\\n]+"; " ")
             | sub("(?: [0-9]*[<>])? ?$"; "")),
        own_config: ($front | test("(?:^|[ \\t])XDG_CONFIG_HOME=")),
        furrow_dir: ($front | env_value("FURROW_DIR")),
        furrow_board: ($front | env_value("FURROW_BOARD")) }
  ];

(.tool_input.command // "" | if type == "string" then . else "" end) as $raw
| (if ($raw | length) > 200000 then null else ($raw | lex) end) as $text
| (if $text != null
   then calls($text; $raw; "(?:(?!(?:echo|printf|furrow)[ \\t])[^\\s|;&`(){}<>]+[ \\t]+)*")
   else calls($raw; $raw; "(?:[A-Za-z_][A-Za-z0-9_]*=\\S*[ \\t]+)*")
   end) as $ops
| if ($ops | length) == 0 then empty
  else {
    ops: $ops,
    lead: (([$raw | match("^\\s*cd[ \\t]+(?:--[ \\t]+)?[\"\\x27]?(/[^\"\\x27\\s;&|]*)[\"\\x27]?[ \\t]*(?:&&|;|\\n)")
             | .captures[0].string] | first) // "")
  }
  end
'

plan=$(printf '%s' "$input" | jq -c "$lexer" 2>/dev/null) || exit 0
[ -n "$plan" ] || exit 0

command -v furrow >/dev/null 2>&1 || exit 0

cfg="${FURROW_CONFIG:-$HOME/.config/furrow/config.toml}"
[ -r "$cfg" ] || exit 0
boards=$(sed -n 's/^[[:space:]]*path[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "$cfg")
[ -n "$boards" ] || exit 0

dir=$(printf '%s' "$input" | jq -r '.cwd // empty | strings' 2>/dev/null)
lead=$(printf '%s' "$plan" | jq -r '.lead // empty | strings' 2>/dev/null)
[ -n "$lead" ] && [ -d "$lead" ] && dir=$lead
[ -n "$dir" ] && [ -d "$dir" ] || dir=.

# Each call is judged against the board IT would write: its own FURROW_DIR /
# FURROW_BOARD, if it assigns one. Fields are joined on \x1f, not a tab: tab is
# IFS whitespace, so `read` would collapse an empty field and shift the rest.
keep=
last_key=
last_store=
while IFS=$'\x1f' read -r i own fd fb; do
  [ -n "$i" ] || continue
  [ "$own" = "false" ] || continue
  key="$fd"$'\x1f'"$fb"
  if [ "$key" != "$last_key" ] || [ -z "$last_store" ]; then
    last_key=$key
    last_store=$(
      cd "$dir" 2>/dev/null || exit 0
      [ -z "$fd" ] || export FURROW_DIR="$fd"
      [ -z "$fb" ] || export FURROW_BOARD="$fb"
      furrow board --json 2>/dev/null | jq -r '.store // empty | strings' 2>/dev/null
    )
  fi
  [ -n "$last_store" ] || continue
  while IFS= read -r board; do
    if [ -n "$board" ] && [ "$last_store" = "$board" ]; then
      keep="$keep${keep:+,}$i"
      break
    fi
  done <<EOF
$boards
EOF
done <<EOF
$(printf '%s' "$plan" | jq -r '
  .ops | to_entries[]
  | [.key, .value.own_config, .value.furrow_dir, .value.furrow_board]
  | map(tostring)
  | if any(.[]; test("[\n\u001f]")) then empty else join("\u001f") end' 2>/dev/null)
EOF
[ -n "$keep" ] || exit 0

agent=$(printf '%s' "$input" | jq -r '.agent_id // empty | strings' 2>/dev/null)

# One line per command, each named as the one decision it is.
printf '%s' "$plan" | jq --arg agent "$agent" --argjson keep "[$keep]" '
  [.ops[$keep[]]] as $ops
  | if $agent != "" then {
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: ("Refused in a subagent: " + ($ops | map(.op) | join(" / ")) + "\n"
        + "Switching the active epic and closing an epic are the human\u0027s decisions. "
        + "They run only after the human approves the exact command in a dialog, and a "
        + "subagent cannot receive that dialog. Do not reach the same write another way "
        + "(a script, an alias, another binary). Return the request to the parent "
        + "session with the box id and the reason; the parent applies to the human "
        + "(epic-ops skill). If this call does not run that command at all, the guard "
        + "misread it: report that to the parent as well.")
    }
  } else {
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "ask",
      permissionDecisionReason: (($ops
          | map((if .kind == "close" then "epic の close です" else "active epic の切り替えです" end) + ": " + .op)
          | join("\n")) + "\n"
        + "これは人が決める操作で、Claude は申請までです。"
        + "この操作をあなたが指示したのなら許可、指示していなければ拒否してください。")
    }
  } end' 2>/dev/null
exit 0
