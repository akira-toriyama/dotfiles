#!/usr/bin/env bash
# claude-epic-guard — PreToolUse guard for the two epic decisions that are the
# human's: switching the active epic and closing an epic.
#
# ASKS before a Bash call runs `furrow epic activate`, `furrow epic deactivate`
# or `furrow epic done` against a board this machine is configured to use. The
# rule it carries (user decision 2026-11-16, projects t-9cby): Claude may APPLY
# for either operation, and it runs only on the human's instruction naming that
# operation — a bare "GO" is not one. The dialog shows the exact command, so the
# human's approval of it IS that instruction; the rule therefore lives here and
# not as prose in a CLAUDE.md. Before this guard the activate half was written
# in five places that disagreed with each other, and the close half nowhere.
# When Claude may apply is a judgment and stays prose: the epic-ops skill.
#
# A subagent gets a DENY, not an ask. A non-interactive subagent has nobody to
# answer a dialog and stops for good — measured on the first version of
# claude-board-shard-guard (2026-08-19). The deny reason sends the request back
# to the parent session, which is the one that can apply to the human.
#
# Measured on Claude Code 2.1.318 (2026-11-16, the guard passed with
# --settings): under auto mode all three commands raised the dialog, with Yes /
# No as the only choices; a decline ran nothing and ended the turn; and a
# headless `claude -p` refused a command that --allowedTools had pre-allowed,
# where the same run without the guard executed it.
#
# What counts as running one of the three commands. The command text is first
# reduced to its command positions: the bodies of heredocs, the contents of
# quotes and `#` comments are masked, because a commit message, a `furrow note`
# body or a grep pattern that mentions a command does not run it — the first
# version matched on the raw text, and a review found it asking about `git
# commit -m '… furrow epic done …'` and about 12 of the 2211 bodies on the
# board. A `$( … )` or a backtick span inside double quotes is a command
# position and stays readable. On what is left, a command is `furrow epic
# <verb>` at the start of a line or after one of | ; & ` ( {, behind optional
# VAR=value assignments, `!`, any run of bare words, and an optional path. The
# bare words are what a session really puts there: a shell keyword (then, do,
# if), command / exec / time / xargs, `go run` — `go run ./cmd/furrow epic done`
# from furrow's own checkout writes the same board — and a wrapper function of
# its own (`step furrow epic done e-1` closed a box on 2026-11-05). echo and
# printf are not wrappers, and neither is furrow itself (`furrow note <id>
# furrow epic …`). An occurrence carrying --help / -h is a read and passes.
#
# Replayed over the 1786 distinct Bash commands that name furrow and epic in
# this machine's transcripts (2026-11-16, a stub furrow reporting the
# configured board for every call): 65 flagged, every one a real call of the
# three commands.
#
# ONLY the configured boards are in scope, and the board is not guessed from the
# path: the guard asks furrow itself (`furrow board --json`, a read) from the
# directory the command will run in — the hook's cwd, or the command's own
# leading `cd /abs` — handing over a FURROW_DIR or FURROW_BOARD the command
# sets for itself, and compares the store it reports with the [[board]] paths
# of furrow's user config. Scratch boards, fixtures and other people's
# checkouts report another store, or none, and pass. That is what keeps furrow's
# own development and the drills on throwaway boards out of the dialog.
#
# Blind spots — each makes the guard MISS a real call:
#   - a command reaching furrow through a script, an alias, a variable, a
#     wrapper given flags of its own (`xargs -n1 furrow …`), or a spelling
#     that quotes or escapes the word furrow itself.
#     `projects repo retire` closes boxes through a script, by design of that
#     command.
#   - a `cd` later than the leading one, or a leading one whose path needs
#     quoting for spaces, is not followed: the board is resolved from the
#     hook's cwd. A FURROW_DIR / FURROW_BOARD given as a shell variable is
#     handed over unexpanded, so furrow resolves nothing and the call passes.
#   - a command that sets XDG_CONFIG_HOME for itself is a rig with its own
#     furrow config, which this process cannot reproduce: it passes.
#   - `$'…'` quoting with an escaped quote inside, and a heredoc whose
#     delimiter line never comes, are read as far as a line-based scan can.
# When the scan ends inside an open quote it has lost track, and the guard
# falls back to the raw text: that errs toward asking, never toward a miss.
#
# Fail-open by construction: no jq, unparseable stdin, another tool, no furrow
# on PATH, a furrow that errors or reports no store, or no readable furrow
# config → allow. FURROW_CONFIG overrides the config path for the tests, as it
# does for claude-board-shard-guard; furrow itself does not read it.
#
# Owned by dotfiles (chezmoi → ~/.local/bin/claude-epic-guard); wired from the
# Claude PreToolUse hook in modify_settings.json (step 12).
# Tests: scripts/test_claude_epic_guard.py (unittest, CI).
set -u

command -v jq >/dev/null 2>&1 || exit 0

input=$(cat 2>/dev/null) || exit 0
[ -n "$input" ] || exit 0
printf '%s' "$input" | jq -e . >/dev/null 2>&1 || exit 0

tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null)
[ "$tool" = "Bash" ] || exit 0

cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty | strings' 2>/dev/null)

# Two substrings first (cheap), so an ordinary Bash call never pays for the scan.
case $cmd in
*furrow*epic*) ;;
*) exit 0 ;;
esac

# Codepoints, since the program sits in single quotes: 39 is the single quote,
# 34 the double quote, 92 the backslash, 96 the backtick, 95 the mask (_).
# Both masks replace one codepoint with one, so an offset found in the masked
# text names the same span in the raw text.
# shellcheck disable=SC2016  # a jq program: its $names are jq's, not the shell's
scan='
def last_index: length - 1;

def mask_heredocs:
  split("\n") as $lines
  | reduce range(0; $lines | length) as $i (
      {out: [], delim: null, strip: false, from: 0};
      $lines[$i] as $line
      | if .delim != null then
          if (if .strip then ($line | sub("^\\t+"; "")) else $line end) == .delim
          then .out += [$line] | .delim = null
          else .out += [$line | gsub("."; "_")]
          end
        else
          .out += [$line]
          | ([$line | match("(?<!<)<<(-?)[ \\t]*(?:\\x27([^\\x27]+)\\x27|\"([^\"]+)\"|\\\\?([A-Za-z_][A-Za-z0-9_]*))")] | first) as $m
          | if $m == null then .
            else .delim = ([$m.captures[1, 2, 3].string] | map(select(. != null)) | first)
              | .strip = ($m.captures[0].string == "-")
              | .from = $i + 1
            end
        end)
  | if .delim != null then .out[: .from] + $lines[.from :] else .out end
  | join("\n");

# States: N top level, P inside $( ) opened in double quotes, B inside
# backticks (all three are command text); S single quotes, D double quotes,
# C a comment (all three are data). depth counts open parentheses per frame
# of command text, so the ) that closes a $( is told from an inner one.
def mask_quotes:
  reduce explode[] as $c (
      {out: [], st: ["N"], depth: [0], esc: false, prev: 10};
      .st[.st | last_index] as $top
      | (.depth | last_index) as $d
      | if $top == "S" then
          (if $c == 39 then .st |= .[:-1] else . end) | .out += [95]
        elif $top == "C" then
          if $c == 10 then (.st |= .[:-1]) | .out += [10] else .out += [95] end
        elif $top == "D" then
          if .esc then .esc = false | .out += [95]
          elif $c == 92 then .esc = true | .out += [95]
          elif $c == 34 then (.st |= .[:-1]) | .out += [95]
          elif $c == 40 and .prev == 36 then .st += ["P"] | .depth += [0] | .out += [40]
          elif $c == 96 then .st += ["B"] | .depth += [0] | .out += [96]
          else .out += [95]
          end
        elif .esc then .esc = false | .out += [if $c == 10 then 32 else 95 end]
        elif $c == 92 then .esc = true | .out += [32]
        elif $c == 39 then .st += ["S"] | .out += [95]
        elif $c == 34 then .st += ["D"] | .out += [95]
        elif $c == 96 then
          if $top == "B" then (.st |= .[:-1]) | (.depth |= .[:-1]) | .out += [96]
          else .st += ["B"] | .depth += [0] | .out += [96]
          end
        elif $c == 40 then .depth[$d] += 1 | .out += [40]
        elif $c == 41 then
          if $top == "P" and .depth[$d] == 0
          then (.st |= .[:-1]) | (.depth |= .[:-1]) | .out += [95]
          else .depth[$d] = ([.depth[$d] - 1, 0] | max) | .out += [41]
          end
        elif $c == 35 and ([.prev] | inside([9, 10, 32, 38, 40, 59, 124])) then
          .st += ["C"] | .out += [95]
        else .out += [$c]
        end
      | .prev = $c)
  | .st[.st | last_index] as $end
  | if $end == "S" or $end == "D" then null else .out | implode end;

def env_value($name):
  ([match("(?:^|[\\s;&|(])" + $name + "=(?:\"([^\"]*)\"|\\x27([^\\x27]*)\\x27|([^\\s;&|)]*))")
    | [.captures[].string] | map(select(. != null)) | first] | first) // "";

(.tool_input.command // "" | if type == "string" then . else "" end) as $raw
| (($raw | mask_heredocs | mask_quotes) // $raw) as $text
| [ $text
    | match("(?:^|[|;&`({\\n])[ \\t]*(?:(?:[A-Za-z_][A-Za-z0-9_]*=\\S*|!|(?!(?:echo|printf|furrow)[ \\t])[A-Za-z_][A-Za-z0-9_.-]*)[ \\t]+)*(?:[^\\s|;&`(){}]*/)?furrow(?:[ \\t]+--?[A-Za-z][A-Za-z0-9-]*(?:=\\S*)?)*[ \\t]+epic[ \\t]+(activate|deactivate|done)(?=[\\s|;&)`}]|$)[^|;&)`\\n]*"; "g")
    | { seen: $text[.offset : .offset + .length],
        op: $raw[.offset : .offset + .length],
        verb: .captures[0].string }
    | select(.seen | test("[ \\t](?:--help|-h)(?:[ \\t]|$)") | not)
    | { kind: (if .verb == "done" then "close" else "switch" end),
        op: (.op | sub("^[|;&`({\\n]?[ \\t]*"; "") | gsub("\\s+"; " ") | sub("(?: [0-9]*[<>])? ?$"; "")) }
  ] as $ops
| if ($ops | length) == 0 then empty
  else {
    ops: $ops,
    own_config: ($raw | test("XDG_CONFIG_HOME=")),
    lead: (([$raw | match("^\\s*cd[ \\t]+(?:--[ \\t]+)?[\"\\x27]?(/[^\"\\x27\\s;&|]*)[\"\\x27]?[ \\t]*(?:&&|;|\\n)")
             | .captures[0].string] | first) // ""),
    furrow_dir: ($raw | env_value("FURROW_DIR")),
    furrow_board: ($raw | env_value("FURROW_BOARD"))
  }
  end
'

plan=$(printf '%s' "$input" | jq -c "$scan" 2>/dev/null) || exit 0
[ -n "$plan" ] || exit 0

field() { printf '%s' "$plan" | jq -r "$1 // empty | strings" 2>/dev/null; }

[ "$(printf '%s' "$plan" | jq -r '.own_config' 2>/dev/null)" = "false" ] || exit 0

command -v furrow >/dev/null 2>&1 || exit 0

cfg="${FURROW_CONFIG:-$HOME/.config/furrow/config.toml}"
[ -r "$cfg" ] || exit 0

dir=$(printf '%s' "$input" | jq -r '.cwd // empty | strings' 2>/dev/null)
lead=$(field .lead)
[ -n "$lead" ] && [ -d "$lead" ] && dir=$lead
[ -n "$dir" ] && [ -d "$dir" ] || dir=.

fd=$(field .furrow_dir)
fb=$(field .furrow_board)

store=$(
  cd "$dir" 2>/dev/null || exit 0
  [ -z "$fd" ] || export FURROW_DIR="$fd"
  [ -z "$fb" ] || export FURROW_BOARD="$fb"
  furrow board --json 2>/dev/null | jq -r '.store // empty | strings' 2>/dev/null
)
[ -n "$store" ] || exit 0

in_scope=0
while IFS= read -r board; do
  [ -n "$board" ] || continue
  [ "$store" = "$board" ] && in_scope=1
done <<EOF
$(sed -n 's/^[[:space:]]*path[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "$cfg")
EOF
[ "$in_scope" -eq 1 ] || exit 0

agent=$(printf '%s' "$input" | jq -r '.agent_id // empty | strings' 2>/dev/null)

# One line per command, each named as the one decision it is.
printf '%s' "$plan" | jq --arg agent "$agent" '
  if $agent != "" then {
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: ("Refused in a subagent: " + (.ops | map(.op) | join(" / ")) + "\n"
        + "Switching the active epic and closing an epic are the human\u0027s decisions. "
        + "They run only after the human approves the exact command in a dialog, and a "
        + "subagent cannot receive that dialog. Do not reach the same write another way "
        + "(a script, an alias, another binary). Return the request to the parent "
        + "session with the box id and the reason; the parent applies to the human "
        + "(epic-ops skill). If this call does not run that command at all, the guard "
        + "misread it: report that to the parent as well.")
    }
  } else {
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "ask",
      permissionDecisionReason: ((.ops
          | map((if .kind == "close" then "epic の close です" else "active epic の切り替えです" end) + ": " + .op)
          | join("\n")) + "\n"
        + "これは人が決める操作で、Claude は申請までです。"
        + "この操作をあなたが指示したのなら許可、指示していなければ拒否してください。")
    }
  } end' 2>/dev/null
exit 0
