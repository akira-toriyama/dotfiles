#!/usr/bin/env python3
"""furrow-epic-table — the furrow boxes as one markdown table.

WHY: `furrow epic ls` gives a box's progress as done/total only, so the
members still open cannot be told apart from the ones parked in icebox —
e-8qyd at 42/43 left open whether its last task was work to pick up or
icebox (projects t-7fw4). One `furrow ls -s icebox` read supplies that
column. claude-list-table-note points a prompt asking for an epic or task
list here, so the answer has one shape.

Usage: furrow-epic-table [-r <owner/repo>]
  -r picks the boxes: it goes to `furrow epic ls` verbatim (a short name
  works, '' is the whole board); without it furrow applies its own scope, as
  on any bare read. The icebox read is always `-r ''`, because 進捗 counts a
  box's members over the whole board: scoped like the boxes, it lost the
  members filed under another repo (e-hn53 read 5/6 with icebox 0 under
  -r akira-toriyama/glyph while its sixth member sat in icebox).

Output: a GitHub markdown table, one row per box in `furrow epic ls` order:
▶ (the active box), id, 進捗 (done/total), icebox (the box's members in the
icebox lane), タイトル (+（常設） on a standing box). A `|` in a title is
escaped so the row keeps its columns.

Exit: 0 with the table; 1 when furrow is missing, fails, or prints JSON of
another shape. furrow's stderr is never captured: its scope notes and its
error envelope reach the caller as furrow wrote them.

Owned by dotfiles (chezmoi → ~/.local/bin/furrow-epic-table).
Tests: scripts/test_furrow_epic_table.py (unittest, run in CI).
"""

from __future__ import annotations

import argparse
import json
import shlex
import subprocess
import sys
from collections import Counter
from typing import Any

PROG = "furrow-epic-table"


class FurrowFailed(Exception):
    pass


def furrow_rows(args: list[str]) -> list[Any]:
    try:
        proc = subprocess.run(
            ["furrow", *args],
            stdout=subprocess.PIPE,
            encoding="utf-8",
            check=False,
        )
    except FileNotFoundError:
        raise FurrowFailed("furrow is not on PATH") from None
    shown = shlex.join(["furrow", *args])
    if proc.returncode != 0:
        raise FurrowFailed(f"`{shown}` exited {proc.returncode}")
    try:
        rows = json.loads(proc.stdout)
    except json.JSONDecodeError:
        raise FurrowFailed(f"`{shown}` printed no JSON") from None
    if not isinstance(rows, list):
        raise FurrowFailed(f"`{shown}` printed JSON that is not an array")
    return rows


def cell(text: str) -> str:
    return (" " + text.replace("|", "\\|") + " ") if text else " "


def row(cells: list[str]) -> str:
    return "|" + "|".join(cell(c) for c in cells) + "|"


def table(epics: list[Any], icebox: list[Any]) -> str:
    # furrow omits `epic` on an unfiled task; it lands under None, which no
    # row reads.
    parked = Counter(t.get("epic") for t in icebox)
    lines = [row(["", "id", "進捗", "icebox", "タイトル"]), "|---|---|---|---|---|"]
    for e in epics:
        progress = f"{e['progress']['done']}/{e['progress']['total']}"
        title = e["title"] + ("（常設）" if e.get("standing") else "")
        mark = "▶" if e.get("active") else ""
        lines.append(row([mark, e["id"], progress, str(parked[e["id"]]), title]))
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog=PROG,
        description="Print the furrow boxes as a markdown table: "
        "id, 進捗 (done/total), icebox members, title.",
    )
    ap.add_argument(
        "-r",
        dest="repos",
        action="append",
        metavar="<owner/repo>",
        help="passed to `furrow epic ls` verbatim ('' = the whole board)",
    )
    args = ap.parse_args(argv)
    scope = [a for r in args.repos or [] for a in ("-r", r)]
    try:
        epics = furrow_rows(["epic", "ls", "--json", *scope])
        icebox = furrow_rows(["ls", "-s", "icebox", "--json", "-r", ""])
        out = table(epics, icebox)
    except FurrowFailed as err:
        print(f"{PROG}: {err}", file=sys.stderr)
        return 1
    except (KeyError, TypeError, AttributeError) as err:
        print(f"{PROG}: unexpected furrow JSON ({err!r})", file=sys.stderr)
        return 1
    print(out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
